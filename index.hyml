!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NghiaLQTV Skin Mod Hub - Liên Quân Mobile</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            400: '#2dd4bf',
                            500: '#14b8a6',
                            600: '#0d9488',
                            cyan: '#06b6d4',
                            purple: '#a855f7',
                            pink: '#ec4899',
                            dark: '#0B0F19',
                            card: '#111827'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts & FontAwesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #07090e;
            color: #f3f4f6;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(6, 182, 212, 0.08) 0%, transparent 45%),
                radial-gradient(circle at 85% 85%, rgba(168, 85, 247, 0.08) 0%, transparent 45%);
            background-attachment: fixed;
        }

        /* Glassmorphism Styles */
        .glass-panel {
            background: rgba(17, 24, 39, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-card {
            background: rgba(21, 29, 46, 0.65);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.06);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            transform: translateY(-4px);
            border-color: rgba(6, 182, 212, 0.4);
            box-shadow: 0 10px 25px -5px rgba(6, 182, 212, 0.15), 0 8px 10px -6px rgba(168, 85, 247, 0.1);
        }

        /* Neon Glows */
        .neon-text-cyan {
            text-shadow: 0 0 10px rgba(6, 182, 212, 0.5), 0 0 20px rgba(6, 182, 212, 0.3);
        }
        .neon-text-purple {
            text-shadow: 0 0 10px rgba(168, 85, 247, 0.5), 0 0 20px rgba(168, 85, 247, 0.3);
        }
        .neon-border {
            box-shadow: 0 0 15px rgba(6, 182, 212, 0.3);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0b0f19;
        }
        ::-webkit-scrollbar-thumb {
            background: #1f2937;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #06b6d4;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-brand-cyan selection:text-black">

    <header class="sticky top-0 z-40 glass-panel border-b border-gray-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
            <!-- Brand Logo -->
            <a href="#" class="flex items-center gap-3 group">
                <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-cyan-500 via-indigo-500 to-purple-600 p-0.5 shadow-lg shadow-cyan-500/20 group-hover:shadow-cyan-500/40 transition-all">
                    <div class="w-full h-full bg-gray-950 rounded-[10px] flex items-center justify-center">
                        <i class="fa-solid font-bold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-400 text-xl">N</i>
                    </div>
                </div>
                <div>
                    <span class="text-xl font-black tracking-wider uppercase bg-gradient-to-r from-cyan-400 via-teal-300 to-purple-400 bg-clip-text text-transparent">
                        NghiaLQTV
                    </span>
                    <span class="block text-xs font-semibold text-cyan-400 tracking-widest uppercase">Skin Mod Hub</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center gap-1 bg-gray-900/60 p-1.5 rounded-xl border border-gray-800">
                <button onclick="switchTab('skins')" id="nav-skins" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium transition-all text-cyan-400 bg-cyan-950/40 border border-cyan-800/50">
                    <i class="fa-solid fa-layer-group mr-2"></i>Kho Mod Skin
                </button>
                <button onclick="switchTab('configurator')" id="nav-configurator" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium transition-all text-gray-400 hover:text-gray-200">
                    <i class="fa-solid fa-sliders mr-2"></i>Mod Customizer
                </button>
                <button onclick="switchTab('guides')" id="nav-guides" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium transition-all text-gray-400 hover:text-gray-200">
                    <i class="fa-solid fa-book-open mr-2"></i>Hướng Dẫn Cài
                </button>
            </nav>

            <!-- Actions & Status -->
            <div class="flex items-center gap-3">
                <span class="hidden lg:inline-flex items-center gap-2 text-xs font-semibold text-emerald-400 bg-emerald-950/40 border border-emerald-800/50 px-3 py-1.5 rounded-full">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    v1.54.1 (Mùa Mới)
                </span>
                <button onclick="switchTab('configurator')" class="px-4 py-2 text-xs sm:text-sm font-bold text-white bg-gradient-to-r from-cyan-500 to-purple-600 rounded-xl hover:from-cyan-400 hover:to-purple-500 transition-all shadow-md shadow-cyan-500/20 active:scale-95">
                    <i class="fa-solid fa-wand-magic-sparkles mr-1.5"></i>Tạo Mod Nhanh
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full">

        <!-- TAB 1: SKINS HUB GRID -->
        <section id="tab-skins" class="space-y-8">
            <!-- Hero Banner -->
            <div class="relative overflow-hidden rounded-3xl p-6 sm:p-10 border border-cyan-500/20 glass-panel bg-gradient-to-r from-gray-950 via-gray-900 to-slate-900 shadow-2xl">
                <div class="absolute -right-16 -top-16 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute -left-16 -bottom-16 w-72 h-72 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

                <div class="relative z-10 max-w-2xl space-y-4">
                    <span class="inline-block px-3 py-1 text-xs font-extrabold uppercase tracking-widest text-cyan-400 bg-cyan-950/60 border border-cyan-800/60 rounded-lg">
                        An Toàn 100% - Khóa Cấm Ban
                    </span>
                    <h1 class="text-3xl sm:text-5xl font-black text-white leading-tight">
                        Tải Mod Skin <span class="bg-gradient-to-r from-cyan-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">Liên Quân Mobile</span> Miễn Phí
                    </h1>
                    <p class="text-gray-400 text-sm sm:text-base leading-relaxed">
                        Tổng hợp đầy đủ Skin Anime, Skin SSS, hiệu ứng biến về custom, âm thanh đầy đủ cho Android & iOS không cần Jailbreak.
                    </p>
                </div>

                <!-- Search and Filter Bar -->
                <div class="mt-8 grid grid-cols-1 sm:grid-cols-12 gap-3">
                    <div class="sm:col-span-8 relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="text" id="searchInput" oninput="filterSkins()" placeholder="Tìm kiếm Tướng hoặc Skin (VD: Florentino, Nakroth, Billow...)" class="w-full bg-gray-950/80 border border-gray-800 focus:border-cyan-500 text-white placeholder-gray-500 rounded-xl pl-11 pr-4 py-3 text-sm outline-none transition-all focus:ring-2 focus:ring-cyan-500/20">
                    </div>
                    <div class="sm:col-span-4">
                        <select id="roleFilter" onchange="filterSkins()" class="w-full bg-gray-950/80 border border-gray-800 focus:border-cyan-500 text-gray-300 rounded-xl px-4 py-3 text-sm outline-none transition-all">
                            <option value="ALL">Tất cả chất tướng</option>
                            <option value="SatThu">Sát Thủ</option>
                            <option value="DauSi">Đấu Sĩ</option>
                            <option value="PhapSu">Pháp Sư</option>
                            <option value="XạThủ">Xạ Thủ</option>
                            <option value="TrợThủ">Trợ Thủ / Đỡ Đòn</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Skin Cards Grid -->
            <div>
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-xl font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-fire text-amber-400"></i>
                        Danh Sách Skin Nổi Bật
                    </h2>
                    <span id="skinCount" class="text-xs font-medium text-gray-400">Đang hiển thị 6 skin</span>
                </div>

                <div id="skinsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Dynamic Skin Cards Rendered via JavaScript -->
                </div>
            </div>
        </section>

        <!-- TAB 2: INTERACTIVE MOD CONFIGURATOR -->
        <section id="tab-configurator" class="hidden space-y-8">
            <div class="text-center max-w-2xl mx-auto space-y-2">
                <h2 class="text-3xl font-black text-white">Tùy Chỉnh Mod Customizer</h2>
                <p class="text-gray-400 text-sm">Tự chọn gói Mod theo sở thích cá nhân: Tích hợp hiệu ứng âm thanh, hiệu ứng biến về, và tối ưu FPS.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <!-- Left Config Box -->
                <div class="lg:col-span-7 glass-panel rounded-2xl p-6 border border-gray-800 space-y-6">
                    <h3 class="text-lg font-bold text-cyan-400 border-b border-gray-800 pb-3 flex items-center gap-2">
                        <i class="fa-solid fa-sliders"></i>
                        1. Chọn Tướng & Skin
                    </h3>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Chọn Tướng</label>
                            <select id="configHeroSelect" onchange="updateConfiguratorSkinList()" class="w-full bg-gray-950 border border-gray-800 focus:border-cyan-500 rounded-xl px-4 py-3 text-sm text-white outline-none">
                                <!-- Options dynamically rendered -->
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Chọn Trang Phục</label>
                            <select id="configSkinSelect" onchange="updateConfigPreview()" class="w-full bg-gray-950 border border-gray-800 focus:border-cyan-500 rounded-xl px-4 py-3 text-sm text-white outline-none">
                                <!-- Options dynamically rendered -->
                            </select>
                        </div>
                    </div>

                    <h3 class="text-lg font-bold text-purple-400 border-b border-gray-800 pb-3 pt-4 flex items-center gap-2">
                        <i class="fa-solid fa-puzzle-piece"></i>
                        2. Tính Năng Bổ Sung
                    </h3>

                    <div class="space-y-4">
                        <!-- Option 1 -->
                        <label class="flex items-center justify-between p-4 bg-gray-950/60 border border-gray-800/80 rounded-xl cursor-pointer hover:border-gray-700 transition-all">
                            <div class="flex items-center gap-3">
                                <i class="fa-solid fa-volume-high text-cyan-400 text-xl"></i>
                                <div>
                                    <div class="text-sm font-semibold text-white">Âm thanh & Voice Mod</div>
                                    <div class="text-xs text-gray-400">Tiếng lồng tiếng chuẩn Anime / Nhật Bản</div>
                                </div>
                            </div>
                            <input type="checkbox" id="optSound" checked class="w-5 h-5 accent-cyan-500 rounded cursor-pointer">
                        </label>

                        <!-- Option 2 -->
                        <label class="flex items-center justify-between p-4 bg-gray-950/60 border border-gray-800/80 rounded-xl cursor-pointer hover:border-gray-700 transition-all">
                            <div class="flex items-center gap-3">
                                <i class="fa-solid fa-bolt text-amber-400 text-xl"></i>
                                <div>
                                    <div class="text-sm font-semibold text-white">Hiệu ứng Biến Về Custom</div>
                                    <div class="text-xs text-gray-400">Vòng biến về độc quyền SSS / Tiên Hiệp</div>
                                </div>
                            </div>
                            <input type="checkbox" id="optRecall" checked class="w-5 h-5 accent-cyan-500 rounded cursor-pointer">
                        </label>

                        <!-- Option 3 -->
                        <label class="flex items-center justify-between p-4 bg-gray-950/60 border border-gray-800/80 rounded-xl cursor-pointer hover:border-gray-700 transition-all">
                            <div class="flex items-center gap-3">
                                <i class="fa-solid fa-gauge-high text-emerald-400 text-xl"></i>
                                <div>
                                    <div class="text-sm font-semibold text-white">Unlock 120 FPS & Giảm Lag</div>
                                    <div class="text-xs text-gray-400">Tối ưu cấu hình mượt cho máy yếu</div>
                                </div>
                            </div>
                            <input type="checkbox" id="opt120fps" checked class="w-5 h-5 accent-cyan-500 rounded cursor-pointer">
                        </label>
                    </div>
                </div>

                <!-- Right Live Preview Box -->
                <div class="lg:col-span-5 glass-panel rounded-2xl p-6 border border-gray-800 flex flex-col justify-between space-y-6">
                    <div>
                        <h3 class="text-lg font-bold text-white border-b border-gray-800 pb-3 mb-4">Xem Trước Gói Mod</h3>
                        
                        <div class="relative aspect-video rounded-xl overflow-hidden border border-gray-800 bg-gray-950 mb-4">
                            <img id="configPreviewImg" src="" alt="Preview" class="w-full h-full object-cover">
                            <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-transparent to-transparent"></div>
                            <div class="absolute bottom-3 left-3 right-3 flex justify-between items-end">
                                <div>
                                    <span id="configPreviewHero" class="text-xs uppercase font-bold text-cyan-400">HERO</span>
                                    <h4 id="configPreviewSkin" class="text-base font-bold text-white">Skin Name</h4>
                                </div>
                                <span class="bg-cyan-950/80 text-cyan-400 border border-cyan-800 px-2.5 py-1 rounded-lg text-xs font-semibold">Ready</span>
                            </div>
                        </div>

                        <div class="space-y-2 text-xs text-gray-300">
                            <div class="flex justify-between py-1 border-b border-gray-800/50">
                                <span class="text-gray-400">Dung lượng ước tính:</span>
                                <span class="font-bold text-white">~45 MB</span>
                            </div>
                            <div class="flex justify-between py-1 border-b border-gray-800/50">
                                <span class="text-gray-400">Tương thích:</span>
                                <span class="font-bold text-emerald-400">Android & iOS</span>
                            </div>
                            <div class="flex justify-between py-1 border-b border-gray-800/50">
                                <span class="text-gray-400">Độ an toàn:</span>
                                <span class="font-bold text-cyan-400">100% Anti-Ban</span>
                            </div>
                        </div>
                    </div>

                    <button onclick="triggerCustomDownload()" class="w-full py-3.5 px-4 bg-gradient-to-r from-cyan-500 via-teal-500 to-purple-600 rounded-xl text-white font-bold text-sm shadow-lg shadow-cyan-500/20 hover:opacity-95 transition-all flex items-center justify-center gap-2">
                        <i class="fa-solid fa-download"></i>
                        Xuất File & Tải Ngay
                    </button>
                </div>
            </div>
        </section>

        <!-- TAB 3: INSTALLATION GUIDES -->
        <section id="tab-guides" class="hidden space-y-8">
            <div class="text-center max-w-2xl mx-auto space-y-2">
                <h2 class="text-3xl font-black text-white">Hướng Dẫn Cài Đặt Chi Tiết</h2>
                <p class="text-gray-400 text-sm">Chọn hệ điều hành thiết bị của bạn để xem từng bước thực hiện.</p>
            </div>

            <!-- OS Toggle Tabs -->
            <div class="flex justify-center gap-4">
                <button onclick="switchGuideOS('android')" id="guide-tab-android" class="px-6 py-2.5 rounded-xl text-sm font-bold transition-all bg-cyan-500 text-black shadow-lg shadow-cyan-500/20">
                    <i class="fa-brands fa-android mr-2"></i>Hướng dẫn Android
                </button>
                <button onclick="switchGuideOS('ios')" id="guide-tab-ios" class="px-6 py-2.5 rounded-xl text-sm font-bold transition-all bg-gray-900 text-gray-400 border border-gray-800 hover:text-white">
                    <i class="fa-brands fa-apple mr-2"></i>Hướng dẫn iOS (iPhone/iPad)
                </button>
            </div>

            <!-- Android Steps -->
            <div id="guide-android" class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-3">
                    <div class="w-10 h-10 rounded-xl bg-cyan-950 border border-cyan-800 flex items-center justify-center font-bold text-cyan-400">1</div>
                    <h3 class="text-base font-bold text-white">Tải ứng dụng ZArchiver</h3>
                    <p class="text-xs text-gray-400 leading-relaxed">
                        Mở Google Play Store (CH Play) và tải ứng dụng <span class="text-cyan-400 font-semibold">ZArchiver</span> dùng để giải nén file Mod (.zip / .7z).
                    </p>
                </div>

                <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-3">
                    <div class="w-10 h-10 rounded-xl bg-cyan-950 border border-cyan-800 flex items-center justify-center font-bold text-cyan-400">2</div>
                    <h3 class="text-base font-bold text-white">Giải Nén File Mod</h3>
                    <p class="text-xs text-gray-400 leading-relaxed">
                        Tải file Mod từ NghiaLQTV Hub. Mở ZArchiver, tìm đến thư mục <span class="text-cyan-400 font-semibold">Download</span> và bấm giải nén file.
                    </p>
                </div>

                <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-3">
                    <div class="w-10 h-10 rounded-xl bg-cyan-950 border border-cyan-800 flex items-center justify-center font-bold text-cyan-400">3</div>
                    <h3 class="text-base font-bold text-white">Dán Vào Data Game</h3>
                    <p class="text-xs text-gray-400 leading-relaxed">
                        Sao chép thư mục <span class="text-cyan-400 font-semibold">com.garena.game.kgvn</span> dán đè vào đường dẫn: <code class="bg-gray-950 px-1 py-0.5 rounded text-amber-400">Android/data/</code>. Mở game và trải nghiệm!
                    </p>
                </div>
            </div>

            <!-- iOS Steps -->
            <div id="guide-ios" class="hidden grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-3">
                    <div class="w-10 h-10 rounded-xl bg-purple-950 border border-purple-800 flex items-center justify-center font-bold text-purple-400">1</div>
                    <h3 class="text-base font-bold text-white">Cài Dùng Sideloadly / Scarlet</h3>
                    <p class="text-xs text-gray-400 leading-relaxed">
                        Tải file IPA Mod hoặc sử dụng công cụ Sideloadly trên máy tính / ứng dụng Scarlet trên iPhone để cài đặt file ứng dụng Mod.
                    </p>
                </div>

                <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-3">
                    <div class="w-10 h-10 rounded-xl bg-purple-950 border border-purple-800 flex items-center justify-center font-bold text-purple-400">2</div>
                    <h3 class="text-base font-bold text-white">Tin Tưởng Chứng Chỉ</h3>
                    <p class="text-xs text-gray-400 leading-relaxed">
                        Vào <span class="text-purple-400 font-semibold">Cài đặt > Cài đặt chung > VPN & Quản lý thiết bị</span> trên iPhone và bấm "Tin tưởng nhà phát triển".
                    </p>
                </div>

                <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-3">
                    <div class="w-10 h-10 rounded-xl bg-purple-950 border border-purple-800 flex items-center justify-center font-bold text-purple-400">3</div>
                    <h3 class="text-base font-bold text-white">Khởi Động & Thưởng Thức</h3>
                    <p class="text-xs text-gray-400 leading-relaxed">
                        Mở game Liên Quân Mobile đã tích hợp Mod Skin, kiểm tra trong phòng đấu tập để tận hưởng hiệu ứng.
                    </p>
                </div>
            </div>
        </section>
    </main>

    <!-- DOWNLOAD MODAL -->
    <div id="downloadModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="glass-panel w-full max-w-md rounded-2xl p-6 border border-gray-800 space-y-6 relative animate-in fade-in zoom-in duration-200">
            <button onclick="closeDownloadModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="text-center space-y-2">
                <div class="w-14 h-14 bg-cyan-950/60 border border-cyan-500/30 rounded-2xl flex items-center justify-center mx-auto text-cyan-400 text-2xl">
                    <i class="fa-solid fa-file-arrow-down"></i>
                </div>
                <h3 id="modalSkinTitle" class="text-xl font-bold text-white">Đang Chuẩn Bị Tệp Mod</h3>
                <p id="modalHeroTitle" class="text-xs text-gray-400">Liên Quân Mobile • Phiên Bản Mới Nhất</p>
            </div>

            <!-- Progress Container -->
            <div class="space-y-2">
                <div class="flex justify-between text-xs font-semibold">
                    <span id="modalProgressStatus" class="text-cyan-400">Đang khởi tạo liên kết...</span>
                    <span id="modalPercentText" class="text-gray-300">0%</span>
                </div>
                <div class="w-full bg-gray-950 h-3 rounded-full overflow-hidden border border-gray-800 p-0.5">
                    <div id="modalProgressBar" class="bg-gradient-to-r from-cyan-400 to-purple-500 h-full rounded-full w-0 transition-all duration-300"></div>
                </div>
            </div>

            <!-- Download Button (Hidden during progress) -->
            <div id="modalDownloadAction" class="hidden">
                <a id="finalDownloadBtn" href="#" onclick="completeDownload()" class="w-full py-3 px-4 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-bold rounded-xl text-center block text-sm shadow-lg shadow-emerald-500/20">
                    <i class="fa-solid fa-cloud-arrow-down mr-2"></i>Tải Tệp Mod Skin (.ZIP)
                </a>
            </div>

            <div class="p-3 bg-gray-950/80 rounded-xl border border-gray-800 text-center text-xs text-gray-400">
                <i class="fa-solid fa-shield-halved text-emerald-400 mr-1"></i>
                Đã được quét An toàn bởi NghiaLQTV Anti-Ban
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-gray-800/80 glass-panel py-8 mt-12">
        <div class="max-w-7xl mx-auto px-4 text-center space-y-4">
            <div class="flex items-center justify-center gap-2">
                <span class="text-lg font-black bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-transparent">NghiaLQTV Hub</span>
            </div>
            <p class="text-xs text-gray-500 max-w-xl mx-auto">
                Trang web chia sẻ bản Mod Skin Liên Quân Mobile phục vụ nhu cầu trải nghiệm cá nhân. Tất cả hình ảnh và bản quyền thuộc về Garena & TiMi Studio Group.
            </p>
            <div class="flex justify-center gap-4 text-xs text-gray-400">
                <a href="#" class="hover:text-cyan-400"><i class="fa-brands fa-youtube text-red-500 mr-1"></i>Kênh Youtube</a>
                <a href="#" class="hover:text-cyan-400"><i class="fa-brands fa-tiktok text-cyan-400 mr-1"></i>Tiktok Official</a>
                <a href="#" class="hover:text-cyan-400"><i class="fa-brands fa-facebook text-blue-500 mr-1"></i>Group Nhóm Fan</a>
            </div>
        </div>
    </footer>

    <!-- Application Logic -->
    <script>
        // Hero & Skin Data Store
        const heroSkinsData = [
            {
                id: "billow",
                hero: "Billow",
                role: "SatThu",
                roleName: "Sát Thủ",
                skinName: "Billow Phong Thần Linh Ẩn",
                tag: "Mod Full Effect SSS",
                tagColor: "bg-purple-950/80 text-purple-300 border-purple-700/50",
                img: "https://images.unsplash.com/photo-1578632767115-351597cf2477?w=600&auto=format&fit=crop&q=80",
                downloads: "24.5K",
                updated: "Hôm nay"
            },
            {
                id: "florentino",
                hero: "Florentino",
                role: "DauSi",
                roleName: "Đấu Sĩ",
                skinName: "Florentino Seven-Eleven Anime",
                tag: "Skin Hợp Tác SSS",
                tagColor: "bg-pink-950/80 text-pink-300 border-pink-700/50",
                img: "https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?w=600&auto=format&fit=crop&q=80",
                downloads: "89.1K",
                updated: "2 ngày trước"
            },
            {
                id: "nakroth",
                hero: "Nakroth",
                role: "SatThu",
                roleName: "Sát Thủ",
                skinName: "Nakroth Lôi Quang Sứ Giả",
                tag: "Unlock Full Voice + Eff",
                tagColor: "bg-cyan-950/80 text-cyan-300 border-cyan-700/50",
                img: "https://images.unsplash.com/photo-1563089145-599997674d42?w=600&auto=format&fit=crop&q=80",
                downloads: "112.3K",
                updated: "Hôm qua"
            },
            {
                id: "raz",
                hero: "Raz",
                role: "PhapSu",
                roleName: "Pháp Sư",
                skinName: "Raz Quyền Vương Siêu Cấp",
                tag: "Âm Thanh Custom",
                tagColor: "bg-amber-950/80 text-amber-300 border-amber-700/50",
                img: "https://images.unsplash.com/photo-1534447677768-be436bb09401?w=600&auto=format&fit=crop&q=80",
                downloads: "45.8K",
                updated: "3 ngày trước"
            },
            {
                id: "krixi",
                hero: "Krixi",
                role: "PhapSu",
                roleName: "Pháp Sư",
                skinName: "Krixi Quạ Đen Ma Pháp",
                tag: "Mod Hiệu Ứng SSS",
                tagColor: "bg-indigo-950/80 text-indigo-300 border-indigo-700/50",
                img: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=600&auto=format&fit=crop&q=80",
                downloads: "38.2K",
                updated: "4 ngày trước"
            },
            {
                id: "telannas",
                hero: "Tel'Annas",
                role: "XạThủ",
                roleName: "Xạ Thủ",
                skinName: "Tel'Annas Thần Thánh Vũ Trụ",
                tag: "Biến Về Độc Quyền",
                tagColor: "bg-emerald-950/80 text-emerald-300 border-emerald-700/50",
                img: "https://images.unsplash.com/photo-1511512578047-dfb367046420?w=600&auto=format&fit=crop&q=80",
                downloads: "67.4K",
                updated: "Hôm nay"
            }
        ];

        // Init page on load
        document.addEventListener("DOMContentLoaded", () => {
            renderSkins(heroSkinsData);
            populateConfiguratorOptions();
        });

        // Render Skin Cards Grid
        function renderSkins(skins) {
            const grid = document.getElementById('skinsGrid');
            const countText = document.getElementById('skinCount');
            grid.innerHTML = '';

            countText.innerText = `Đang hiển thị ${skins.length} skin`;

            if(skins.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-12 text-center text-gray-500">
                        <i class="fa-solid fa-ghost text-4xl mb-3"></i>
                        <p>Không tìm thấy Skin phù hợp với từ khóa của bạn.</p>
                    </div>
                `;
                return;
            }

            skins.forEach(skin => {
                const card = document.createElement('div');
                card.className = "glass-card rounded-2xl overflow-hidden flex flex-col justify-between";
                card.innerHTML = `
                    <div>
                        <!-- Thumbnail Image -->
                        <div class="relative aspect-video overflow-hidden group">
                            <img src="${skin.img}" alt="${skin.skinName}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-transparent to-transparent"></div>
                            
                            <span class="absolute top-3 left-3 px-2.5 py-1 text-[10px] font-extrabold uppercase rounded-lg border ${skin.tagColor}">
                                ${skin.tag}
                            </span>

                            <span class="absolute bottom-2 right-3 text-[11px] font-semibold text-gray-300 flex items-center gap-1">
                                <i class="fa-solid fa-download text-cyan-400"></i> ${skin.downloads}
                            </span>
                        </div>

                        <!-- Card Body -->
                        <div class="p-5 space-y-2">
                            <div class="text-xs font-bold uppercase text-cyan-400 tracking-wider">${skin.hero} • ${skin.roleName}</div>
                            <h3 class="text-base font-bold text-white group-hover:text-cyan-300 transition-colors">${skin.skinName}</h3>
                        </div>
                    </div>

                    <!-- Card Actions -->
                    <div class="px-5 pb-5 pt-2 border-t border-gray-800/40 flex items-center gap-2">
                        <button onclick="openDownloadModal('${skin.hero}', '${skin.skinName}')" class="flex-1 py-2.5 px-3 bg-gradient-to-r from-cyan-500 to-purple-600 hover:from-cyan-400 hover:to-purple-500 text-white rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 shadow-md shadow-cyan-500/10">
                            <i class="fa-solid fa-download"></i> Tải Skin Pack
                        </button>
                        <button onclick="switchTab('configurator')" class="p-2.5 bg-gray-900 hover:bg-gray-800 border border-gray-800 text-gray-300 rounded-xl text-xs font-medium transition-all" title="Tùy chỉnh thêm">
                            <i class="fa-solid fa-sliders"></i>
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Filter skins by keyword and role
        function filterSkins() {
            const searchVal = document.getElementById('searchInput').value.toLowerCase();
            const roleVal = document.getElementById('roleFilter').value;

            const filtered = heroSkinsData.filter(item => {
                const matchesSearch = item.hero.toLowerCase().includes(searchVal) || item.skinName.toLowerCase().includes(searchVal);
                const matchesRole = roleVal === 'ALL' || item.role === roleVal;
                return matchesSearch && matchesRole;
            });

            renderSkins(filtered);
        }

        // Switch Tabs (Skins / Configurator / Guides)
        function switchTab(tabName) {
            document.getElementById('tab-skins').classList.add('hidden');
            document.getElementById('tab-configurator').classList.add('hidden');
            document.getElementById('tab-guides').classList.add('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.className = "nav-btn px-4 py-2 rounded-lg text-sm font-medium transition-all text-gray-400 hover:text-gray-200";
            });

            if(tabName === 'skins') {
                document.getElementById('tab-skins').classList.remove('hidden');
                document.getElementById('nav-skins').className = "nav-btn px-4 py-2 rounded-lg text-sm font-medium transition-all text-cyan-400 bg-cyan-950/40 border border-cyan-800/50";
            } else if(tabName === 'configurator') {
                document.getElementById('tab-configurator').classList.remove('hidden');
                document.getElementById('nav-configurator').className = "nav-btn px-4 py-2 rounded-lg text-sm font-medium transition-all text-cyan-400 bg-cyan-950/40 border border-cyan-800/50";
            } else if(tabName === 'guides') {
                document.getElementById('tab-guides').classList.remove('hidden');
                document.getElementById('nav-guides').className = "nav-btn px-4 py-2 rounded-lg text-sm font-medium transition-all text-cyan-400 bg-cyan-950/40 border border-cyan-800/50";
            }
        }

        // Populate Options for Configurator
        function populateConfiguratorOptions() {
            const heroSelect = document.getElementById('configHeroSelect');
            heroSelect.innerHTML = '';

            heroSkinsData.forEach(item => {
                const opt = document.createElement('option');
                opt.value = item.id;
                opt.innerText = `${item.hero} (${item.roleName})`;
                heroSelect.appendChild(opt);
            });

            updateConfiguratorSkinList();
        }

        function updateConfiguratorSkinList() {
            const selectedHeroId = document.getElementById('configHeroSelect').value;
            const skinSelect = document.getElementById('configSkinSelect');
            skinSelect.innerHTML = '';

            const item = heroSkinsData.find(h => h.id === selectedHeroId);
            if(item) {
                const opt = document.createElement('option');
                opt.value = item.skinName;
                opt.innerText = item.skinName;
                skinSelect.appendChild(opt);
            }

            updateConfigPreview();
        }

        function updateConfigPreview() {
            const selectedHeroId = document.getElementById('configHeroSelect').value;
            const item = heroSkinsData.find(h => h.id === selectedHeroId);

            if(item) {
                document.getElementById('configPreviewImg').src = item.img;
                document.getElementById('configPreviewHero').innerText = item.hero;
                document.getElementById('configPreviewSkin').innerText = item.skinName;
            }
        }

        // Switch Guides OS
        function switchGuideOS(os) {
            const btnAndroid = document.getElementById('guide-tab-android');
            const btnIos = document.getElementById('guide-tab-ios');
            const secAndroid = document.getElementById('guide-android');
            const secIos = document.getElementById('guide-ios');

            if(os === 'android') {
                btnAndroid.className = "px-6 py-2.5 rounded-xl text-sm font-bold transition-all bg-cyan-500 text-black shadow-lg shadow-cyan-500/20";
                btnIos.className = "px-6 py-2.5 rounded-xl text-sm font-bold transition-all bg-gray-900 text-gray-400 border border-gray-800 hover:text-white";
                secAndroid.classList.remove('hidden');
                secIos.classList.add('hidden');
            } else {
                btnIos.className = "px-6 py-2.5 rounded-xl text-sm font-bold transition-all bg-purple-500 text-white shadow-lg shadow-purple-500/20";
                btnAndroid.className = "px-6 py-2.5 rounded-xl text-sm font-bold transition-all bg-gray-900 text-gray-400 border border-gray-800 hover:text-white";
                secIos.classList.remove('hidden');
                secAndroid.classList.add('hidden');
            }
        }

        // Trigger Custom Download from Configurator
        function triggerCustomDownload() {
            const heroName = document.getElementById('configPreviewHero').innerText;
            const skinName = document.getElementById('configPreviewSkin').innerText;
            openDownloadModal(heroName, skinName);
        }

        // Modal System & Download Progress Simulation
        let downloadTimer = null;

        function openDownloadModal(hero, skin) {
            document.getElementById('modalSkinTitle').innerText = skin;
            document.getElementById('modalHeroTitle').innerText = `Tướng: ${hero} • Tải xuống gói Zip`;
            document.getElementById('downloadModal').classList.remove('hidden');

            // Reset progress
            const progressBar = document.getElementById('modalProgressBar');
            const percentText = document.getElementById('modalPercentText');
            const statusText = document.getElementById('modalProgressStatus');
            const actionBtn = document.getElementById('modalDownloadAction');

            progressBar.style.width = '0%';
            percentText.innerText = '0%';
            statusText.innerText = 'Đang khởi tạo liên kết an toàn...';
            actionBtn.classList.add('hidden');

            let progress = 0;
            clearInterval(downloadTimer);

            downloadTimer = setInterval(() => {
                progress += Math.floor(Math.random() * 15) + 10;
                if(progress >= 100) {
                    progress = 100;
                    clearInterval(downloadTimer);
                    statusText.innerText = 'Sẵn sàng tải xuống!';
                    actionBtn.classList.remove('hidden');
                } else if(progress > 50) {
                    statusText.innerText = 'Đang tối ưu tệp Mod...';
                }
                progressBar.style.width = `${progress}%`;
                percentText.innerText = `${progress}%`;
            }, 300);
        }

        function closeDownloadModal() {
            clearInterval(downloadTimer);
            document.getElementById('downloadModal').classList.add('hidden');
        }

        function completeDownload() {
            setTimeout(() => {
                closeDownloadModal();
            }, 500);
        }
    </script>
</body>
</html>
